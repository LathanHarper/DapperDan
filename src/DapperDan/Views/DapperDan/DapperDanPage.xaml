                AutomationId="DapperDan_MenuPanel"
                Padding="20,86,20,140"
                pb:PanelBoss.DoThatSmokyBackgroundThing="#99102A3A"
                pb:PanelBoss.PanelIsVisible="False"
                pb:PanelBoss.PanelName="DapperDanMenuPanel"
                pb:PanelBoss.PanelPriority="0"
                pb:PanelBoss.PanelTransitionIn="FadeInDownward"
                pb:PanelBoss.PanelTransitionOut="FadeOutUpward">
                <Border BackgroundColor="#FFFFFF" HorizontalOptions="End" Padding="16" Stroke="#B9CED8" StrokeShape="RoundRectangle 18" VerticalOptions="Start" WidthRequest="290">
                    <VerticalStackLayout Spacing="12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><Label FontAttributes="Bold" FontSize="18" Text="Menu lane" TextColor="#173E52" VerticalTextAlignment="Center" /><controls:RichButton Grid.Column="1" AutomationId="DapperDan_Menu_Close" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="CloseMenu" HeightRequest="42"><Border BackgroundColor="#EDF5F8" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 12"><Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="×" TextColor="#075985" VerticalTextAlignment="Center" /></Border></controls:RichButton></Grid>
                        <Label Style="{StaticResource BodyCopy}" Text="A smoky floating action card, still page-owned PLOXM." />
                        <controls:RichButton AutomationId="DapperDan_Menu_Status" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="Status" HeightRequest="52"><Border BackgroundColor="#FFF8E6" InputTransparent="True" Stroke="#E7C76B" StrokeShape="RoundRectangle 14"><Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Toggle status ribbon" TextColor="#7A5B16" VerticalTextAlignment="Center" /></Border></controls:RichButton>
                        <controls:RichButton AutomationId="DapperDan_Menu_Dialog" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="Dialog" HeightRequest="52"><Border BackgroundColor="#FFECE8" InputTransparent="True" Stroke="#E7A496" StrokeShape="RoundRectangle 14"><Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Open dialog" TextColor="#8E3C2C" VerticalTextAlignment="Center" /></Border></controls:RichButton>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </panelViews:PanelBossBody_DefaultView.MenuPanels>

        <panelViews:PanelBossBody_DefaultView.BottomInputPanels>
            <Grid
                AutomationId="DapperDan_PageActions"
                BackgroundColor="#FFFFFF"
                HeightRequest="82"
                Padding="6,7"
                pb:PanelBoss.PanelIsVisible="True"
                pb:PanelBoss.PanelName="DapperDanPageActions"
                pb:PanelBoss.PanelPriority="10"
                pb:PanelBoss.PanelTransitionIn="None"
                pb:PanelBoss.PanelTransitionOut="None">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:RichButton AutomationId="DapperDan_Action_Buttons" Command="{Binding SelectPageActionCommand}" CommandParameter="{Binding ButtonsAction}" IsBusy="{Binding ButtonsAction.IsBusy, Mode=TwoWay}" Margin="2">
                    <Border BackgroundColor="{Binding ButtonsAction.BackgroundColor}" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14"><VerticalStackLayout InputTransparent="True" Spacing="1" VerticalOptions="Center"><Label FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding ButtonsAction.Glyph}" TextColor="{Binding ButtonsAction.TextColor}" /><Label FontSize="10" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding ButtonsAction.Title}" TextColor="{Binding ButtonsAction.TextColor}" /></VerticalStackLayout></Border>
                </controls:RichButton>
                <controls:RichButton Grid.Column="1" AutomationId="DapperDan_Action_Panels" Command="{Binding SelectPageActionCommand}" CommandParameter="{Binding PanelsAction}" IsBusy="{Binding PanelsAction.IsBusy, Mode=TwoWay}" Margin="2">
                    <Border BackgroundColor="{Binding PanelsAction.BackgroundColor}" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14"><VerticalStackLayout InputTransparent="True" Spacing="1" VerticalOptions="Center"><Label FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding PanelsAction.Glyph}" TextColor="{Binding PanelsAction.TextColor}" /><Label FontSize="10" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding PanelsAction.Title}" TextColor="{Binding PanelsAction.TextColor}" /></VerticalStackLayout></Border>
                </controls:RichButton>
                <controls:RichButton Grid.Column="2" AutomationId="DapperDan_Action_Motion" Command="{Binding SelectPageActionCommand}" CommandParameter="{Binding MotionAction}" IsBusy="{Binding MotionAction.IsBusy, Mode=TwoWay}" Margin="2">
                    <Border BackgroundColor="{Binding MotionAction.BackgroundColor}" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14"><VerticalStackLayout InputTransparent="True" Spacing="1" VerticalOptions="Center"><Label FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding MotionAction.Glyph}" TextColor="{Binding MotionAction.TextColor}" /><Label FontSize="10" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding MotionAction.Title}" TextColor="{Binding MotionAction.TextColor}" /></VerticalStackLayout></Border>
                </controls:RichButton>
                <controls:RichButton Grid.Column="3" AutomationId="DapperDan_Action_Witness" Command="{Binding SelectPageActionCommand}" CommandParameter="{Binding WitnessAction}" IsBusy="{Binding WitnessAction.IsBusy, Mode=TwoWay}" Margin="2">
                    <Border BackgroundColor="{Binding WitnessAction.BackgroundColor}" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14"><VerticalStackLayout InputTransparent="True" Spacing="1" VerticalOptions="Center"><Label FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding WitnessAction.Glyph}" TextColor="{Binding WitnessAction.TextColor}" /><Label FontSize="10" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding WitnessAction.Title}" TextColor="{Binding WitnessAction.TextColor}" /></VerticalStackLayout></Border>
                </controls:RichButton>
                <controls:RichButton Grid.Column="4" AutomationId="DapperDan_Action_More" Command="{Binding SelectPageActionCommand}" CommandParameter="{Binding MoreAction}" IsBusy="{Binding MoreAction.IsBusy, Mode=TwoWay}" Margin="2">
                    <Border BackgroundColor="{Binding MoreAction.BackgroundColor}" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14"><VerticalStackLayout InputTransparent="True" Spacing="1" VerticalOptions="Center"><Label FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding MoreAction.Glyph}" TextColor="{Binding MoreAction.TextColor}" /><Label FontSize="10" HorizontalTextAlignment="Center" InputTransparent="True" Text="{Binding MoreAction.Title}" TextColor="{Binding MoreAction.TextColor}" /></VerticalStackLayout></Border>
                </controls:RichButton>
            </Grid>

            <Grid
                AutomationId="DapperDan_BottomSheet"
                BackgroundColor="#E6F2FF"
                HeightRequest="310"
                Padding="20,18,20,26"
                pb:PanelBoss.DoThatSmokyBackgroundThing="#66102A3A"
                pb:PanelBoss.PanelIsVisible="False"
                pb:PanelBoss.PanelName="DapperDanBottomSheet"
                pb:PanelBoss.PanelPriority="0"
                pb:PanelBoss.PanelSizingMode="Viewport"
                pb:PanelBoss.PanelTransitionIn="SlideInUpward"
                pb:PanelBoss.PanelTransitionOut="SlideOutDownward"
                pb:PanelBoss.PartOfSafeArea="False">
                <VerticalStackLayout Spacing="14">
                    <BoxView BackgroundColor="#92BCE0" HeightRequest="5" HorizontalOptions="Center" WidthRequest="54" />
                    <Label Style="{StaticResource SectionTitle}" Text="Viewport bottom sheet" />
                    <Label Style="{StaticResource BodyCopy}" Text="This second BottomInput panel replaces the five-cell strip while open, then hands control back to the highest-priority default panel." />
                    <controls:RichButton AutomationId="DapperDan_BottomSheet_Status" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="Status" HeightRequest="54"><Border BackgroundColor="#FFFFFF" InputTransparent="True" Stroke="#92BCE0" StrokeShape="RoundRectangle 14"><Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Send status ribbon" TextColor="#245A87" VerticalTextAlignment="Center" /></Border></controls:RichButton>
                    <controls:RichButton AutomationId="DapperDan_BottomSheet_Close" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="CloseSheet" HeightRequest="54"><Border BackgroundColor="#245A87" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Close sheet" TextColor="White" VerticalTextAlignment="Center" /></Border></controls:RichButton>
                </VerticalStackLayout>
            </Grid>
        </panelViews:PanelBossBody_DefaultView.BottomInputPanels>

        <panelViews:PanelBossBody_DefaultView.BottomStatusPanels>
            <Grid
                AutomationId="DapperDan_StatusPanel"
                BackgroundColor="#173E52"
                HeightRequest="54"
                Margin="12,0,12,122"
                Padding="14,8"
                pb:PanelBoss.PanelIsVisible="False"
                pb:PanelBoss.PanelName="DapperDanStatusPanel"
                pb:PanelBoss.PanelPriority="0"
                pb:PanelBoss.PanelTransitionIn="FadeInDownward"
                pb:PanelBoss.PanelTransitionOut="FadeOutUpward">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                <Label FontSize="12" Text="{Binding StatusMessage}" TextColor="White" VerticalTextAlignment="Center" />
                <controls:RichButton Grid.Column="1" AutomationId="DapperDan_Status_Close" AutoResetIsBusyMilliseconds="500" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="CloseStatus" HeightRequest="40"><Border BackgroundColor="#2D5B70" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 12"><Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="×" TextColor="White" VerticalTextAlignment="Center" /></Border></controls:RichButton>
            </Grid>
        </panelViews:PanelBossBody_DefaultView.BottomStatusPanels>

        <panelViews:PanelBossBody_DefaultView.FullScreenPopupPanels>
            <Grid
                AutomationId="DapperDan_DialogPanel"
                Padding="24"
                pb:PanelBoss.DoThatSmokyBackgroundThing="#AA102A3A"
                pb:PanelBoss.PanelIsVisible="False"
                pb:PanelBoss.PanelName="DapperDanDialogPanel"
                pb:PanelBoss.PanelPriority="0"
                pb:PanelBoss.PanelTransitionIn="FadeInDownward"
                pb:PanelBoss.PanelTransitionOut="FadeOutUpward">
                <Border BackgroundColor="#FFFFFF" HorizontalOptions="Center" MaximumWidthRequest="420" Padding="22" Stroke="#B9CED8" StrokeShape="RoundRectangle 22" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="16">
                        <Label Style="{StaticResource PageTitle}" Text="Popup archetype" />
                        <Label Style="{StaticResource BodyCopy}" Text="A page-owned modal card mounted in FullScreenPopupPanels. The smoke and motion belong to the panel contract." />
                        <controls:RichButton AutomationId="DapperDan_Dialog_Close" AutoResetIsBusyMilliseconds="650" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="CloseDialog" HeightRequest="54"><Border BackgroundColor="#075985" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Close dialog" TextColor="White" VerticalTextAlignment="Center" /></Border></controls:RichButton>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid
                AutomationId="DapperDan_LoadingPanel"
                pb:PanelBoss.DoThatSmokyBackgroundThing="#BB102A3A"
                pb:PanelBoss.PanelIsVisible="False"
                pb:PanelBoss.PanelName="DapperDanLoadingPanel"
                pb:PanelBoss.PanelPriority="0"
                pb:PanelBoss.PanelTransitionIn="FadeInDownward"
                pb:PanelBoss.PanelTransitionOut="FadeOutUpward">
                <Border BackgroundColor="#173E52" HorizontalOptions="Center" Padding="26" StrokeThickness="0" StrokeShape="RoundRectangle 22" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="14">
                        <ActivityIndicator AutomationId="DapperDan_LoadingSpinner" Color="#F8C15C" IsRunning="True" />
                        <Label FontAttributes="Bold" HorizontalTextAlignment="Center" Text="Owned presentation fence" TextColor="White" />
                        <Label FontSize="12" HorizontalTextAlignment="Center" Text="Waiting for visible opacity, not a guessed delay." TextColor="#CDE2EC" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </panelViews:PanelBossBody_DefaultView.FullScreenPopupPanels>
    </panelViews:PanelBossBody_DefaultView>
</ContentPage>
