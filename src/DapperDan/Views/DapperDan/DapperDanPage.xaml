<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="PageRoot"
    x:Class="CodeCrafty.DapperDan.Views.DapperDan.DapperDanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CodeCrafty.DapperDan.Controls"
    xmlns:data="clr-namespace:CodeCrafty.DapperDan.Data.Entities"
    xmlns:models="clr-namespace:CodeCrafty.DapperDan.Models"
    xmlns:pb="clr-namespace:CodeCrafty.DapperDan.PanelBossKit"
    xmlns:panelViews="clr-namespace:CodeCrafty.DapperDan.PanelBossKit.Views"
    xmlns:vm="clr-namespace:CodeCrafty.DapperDan.ViewModels"
    AutomationId="DapperDan_Page"
    BackgroundColor="#EAF2F5"
    HideSoftInputOnTapped="True"
    NavigationPage.HasNavigationBar="False"
    x:DataType="vm:DapperDanViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="#102A3A" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="#173E52" />
            </Style>
            <Style x:Key="BodyCopy" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="TextColor" Value="#486171" />
            </Style>
            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="PlaceholderColor" Value="#78909C" />
                <Setter Property="TextColor" Value="#102A3A" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <panelViews:PanelBossBody_DefaultView
        x:Name="PanelBossRoot"
        AutomationId="DapperDan_PanelBossRoot"
        BackgroundColor="#EAF2F5"
        HorizontalOptions="Fill"
        PanelBossInstance="{Binding ActivePanelBoss}"
        VerticalOptions="Fill">

        <panelViews:PanelBossBody_DefaultView.NonVisualControls>
            <Grid
                AutomationId="DapperDan_NonVisualLaneWitness"
                pb:PanelBoss.PanelIsVisible="True"
                pb:PanelBoss.PanelName="DapperDanNonVisualWitness"
                pb:PanelBoss.PanelPriority="10">
                <Label
                    AutomationId="DapperDan_StatusProbe"
                    Text="{Binding StatusMessage}" />
            </Grid>
        </panelViews:PanelBossBody_DefaultView.NonVisualControls>

        <panelViews:PanelBossBody_DefaultView.TopHeaderPagePanels>
            <Grid
                AutomationId="DapperDan_TourPanel"
                BackgroundColor="#0B3C5D"
                pb:PanelBoss.PanelIsVisible="False"
                pb:PanelBoss.PanelName="DapperDanTourPanel"
                pb:PanelBoss.PanelPriority="0"
                pb:PanelBoss.PanelTransitionIn="FadeInDownward"
                pb:PanelBoss.PanelTransitionOut="FadeOutUpward">
                <ScrollView>
                    <VerticalStackLayout Padding="28,64,28,36" Spacing="22">
                        <Label
                            FontAttributes="Bold"
                            FontSize="30"
                            Text="The full PanelBoss tour"
                            TextColor="White" />
                        <Label
                            FontSize="16"
                            Text="This TopHeaderPage lane can temporarily own the whole viewport while the page and its commands remain alive underneath."
                            TextColor="#D9EDF7" />
                        <Border
                            BackgroundColor="#145374"
                            Padding="18"
                            Stroke="#4DA3C7"
                            StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="8">
                                <Label FontAttributes="Bold" Text="Mounted lanes" TextColor="White" />
                                <Label Text="NonVisual · TopHeaderPage · TopHeader · Content · Left · Right · Menu · BottomInput · BottomStatus · FullScreenPopup" TextColor="#D9EDF7" />
                            </VerticalStackLayout>
                        </Border>
                        <controls:RichButton
                            AutomationId="DapperDan_Tour_Close"
                            AutoResetIsBusyMilliseconds="700"
                            Command="{Binding ExecutePanelDemoCommand}"
                            CommandParameter="Tour"
                            HeightRequest="56">
                            <Border
                                BackgroundColor="#F8C15C"
                                InputTransparent="True"
                                Padding="18"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                                <Label
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    InputTransparent="True"
                                    Text="Close the tour"
                                    TextColor="#102A3A" />
                            </Border>
                        </controls:RichButton>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </panelViews:PanelBossBody_DefaultView.TopHeaderPagePanels>

        <panelViews:PanelBossBody_DefaultView.TopHeaderPanels>
            <Grid
                AutomationId="DapperDan_HeaderPanel"
                BackgroundColor="#FFFFFF"
                HeightRequest="72"
                Padding="14,8"
                pb:PanelBoss.PanelIsVisible="True"
                pb:PanelBoss.PanelName="DapperDanHeaderPanel"
                pb:PanelBoss.PanelPriority="10"
                pb:PanelBoss.PanelTransitionIn="None"
                pb:PanelBoss.PanelTransitionOut="None">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <controls:RichButton
                    AutomationId="DapperDan_Header_Palette"
                    AutoResetIsBusyMilliseconds="650"
                    Command="{Binding ExecutePanelDemoCommand}"
                    CommandParameter="Palette"
                    HeightRequest="48"
                    WidthRequest="48">
                    <Border BackgroundColor="#DDF3F8" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Label FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" InputTransparent="True" Text="≡" TextColor="#075985" VerticalTextAlignment="Center" />
                    </Border>
                </controls:RichButton>
                <VerticalStackLayout Grid.Column="1" Padding="8,0" Spacing="0" VerticalOptions="Center">
                    <Label FontAttributes="Bold" FontSize="20" Text="DapperDan" TextColor="#102A3A" />
                    <Label FontSize="12" Text="PanelBoss + PLOXM expression" TextColor="#607D8B" />
                </VerticalStackLayout>
                <controls:RichButton
                    Grid.Column="2"
                    AutomationId="DapperDan_Header_Inspector"
                    AutoResetIsBusyMilliseconds="650"
                    Command="{Binding ExecutePanelDemoCommand}"
                    CommandParameter="Inspector"
                    HeightRequest="48"
                    WidthRequest="48">
                    <Border BackgroundColor="#EDF5F8" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Label FontAttributes="Bold" FontSize="17" HorizontalTextAlignment="Center" InputTransparent="True" Text="i" TextColor="#075985" VerticalTextAlignment="Center" />
                    </Border>
                </controls:RichButton>
                <controls:RichButton
                    Grid.Column="3"
                    AutomationId="DapperDan_Header_Menu"
                    AutoResetIsBusyMilliseconds="650"
                    Command="{Binding ExecutePanelDemoCommand}"
                    CommandParameter="Menu"
                    HeightRequest="48"
                    WidthRequest="48">
                    <Border BackgroundColor="#EDF5F8" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Label FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" InputTransparent="True" Text="•••" TextColor="#075985" VerticalTextAlignment="Center" />
                    </Border>
                </controls:RichButton>
            </Grid>
        </panelViews:PanelBossBody_DefaultView.TopHeaderPanels>

        <panelViews:PanelBossBody_DefaultView.ContentPanels>
            <Grid
                AutomationId="DapperDan_ButtonsPanel"
                BackgroundColor="#EAF2F5"
                pb:PanelBoss.PanelIsVisible="True"
                pb:PanelBoss.PanelName="DapperDanButtonsPanel"
                pb:PanelBoss.PanelPriority="10"
                pb:PanelBoss.PanelTransitionIn="None"
                pb:PanelBoss.PanelTransitionOut="None">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" pb:PanelBoss.PanelClearanceFor="DapperDanHeaderPanel" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="116" pb:PanelBoss.PanelClearanceFor="DapperDanPageActions" />
                </Grid.RowDefinitions>
                <ScrollView Grid.Row="1" AutomationId="DapperDan_ButtonsScrollView">
                    <VerticalStackLayout Padding="18,18,18,28" Spacing="20">
                        <VerticalStackLayout Spacing="5">
                            <Label Style="{StaticResource PageTitle}" Text="PLOXM RichButton gallery" />
                            <Label Style="{StaticResource BodyCopy}" Text="Every face below belongs to this page: plain XAML, one RichButton host, and no packaged product widget hiding the composition." />
                        </VerticalStackLayout>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72" />
                                <RowDefinition Height="72" />
                                <RowDefinition Height="72" />
                                <RowDefinition Height="72" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:RichButton
                                AutomationId="DapperDan_Specimen_Primary"
                                AutoResetIsBusyMilliseconds="650"
                                Command="{Binding ExecutePanelDemoCommand}"
                                CommandParameter="Status">
                                <Border
                                    BackgroundColor="#075985"
                                    InputTransparent="True"
                                    Padding="14"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="RichInteractionStates">
                                            <VisualState Name="WaitingForTouch">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#075985" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="IsProcessing">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#5791A9" />
                                                    <Setter Property="Opacity" Value="0.78" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Primary action" TextColor="White" VerticalTextAlignment="Center" />
                                </Border>
                            </controls:RichButton>

                            <controls:RichButton
                                Grid.Column="1"
                                AutomationId="DapperDan_Specimen_IconOnly"
                                AutoResetIsBusyMilliseconds="650"
                                Command="{Binding ExecutePanelDemoCommand}"
                                CommandParameter="Menu">
                                <Border BackgroundColor="#FFFFFF" InputTransparent="True" Padding="14" Stroke="#B9CED8" StrokeShape="RoundRectangle 16">
                                    <Label FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" InputTransparent="True" Text="✦" TextColor="#075985" VerticalTextAlignment="Center" />
                                </Border>
                            </controls:RichButton>

                            <controls:RichButton
                                Grid.Row="1"
                                AutomationId="DapperDan_Specimen_DetailRow"
                                AutoResetIsBusyMilliseconds="650"
                                Command="{Binding ExecutePanelDemoCommand}"
                                CommandParameter="Inspector">
                                <Border BackgroundColor="#FFFFFF" InputTransparent="True" Padding="12" Stroke="#B9CED8" StrokeShape="RoundRectangle 16">
                                    <Grid ColumnSpacing="10" InputTransparent="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border BackgroundColor="#DDF3F8" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                            <Label HorizontalTextAlignment="Center" InputTransparent="True" Text="RB" TextColor="#075985" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" InputTransparent="True" Spacing="1" VerticalOptions="Center">
                                            <Label FontAttributes="Bold" FontSize="14" InputTransparent="True" Text="Detail row" TextColor="#173E52" />
                                            <Label FontSize="11" InputTransparent="True" Text="Icon, text, tail" TextColor="#607D8B" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" InputTransparent="True" Text="›" TextColor="#075985" VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </controls:RichButton>

                            <controls:RichButton
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationId="DapperDan_Specimen_AvatarBadge"
                                AutoResetIsBusyMilliseconds="650"
                                Command="{Binding ExecutePanelDemoCommand}"
                                CommandParameter="Palette">
                                <Border BackgroundColor="#FFF8E6" InputTransparent="True" Padding="12" Stroke="#E7C76B" StrokeShape="RoundRectangle 16">
                                    <Grid ColumnSpacing="8" InputTransparent="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border BackgroundColor="#F8C15C" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 21">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="K" TextColor="#102A3A" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" InputTransparent="True" Spacing="1" VerticalOptions="Center">
                                            <Label FontAttributes="Bold" InputTransparent="True" Text="Avatar + badge" TextColor="#173E52" />
                                            <Label FontSize="11" InputTransparent="True" Text="3 new memories" TextColor="#7A5B16" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </controls:RichButton>

                            <controls:RichButton
                                Grid.Row="2"
                                AutomationId="DapperDan_Specimen_SelectedCard"
                                AutoResetIsBusyMilliseconds="650"
                                Command="{Binding ExecutePanelDemoCommand}"
                                CommandParameter="Tour">
                                <Border BackgroundColor="#E9F8F0" InputTransparent="True" Padding="12" Stroke="#87C9A5" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout InputTransparent="True" Spacing="2" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Selected card" TextColor="#17613B" />
                                        <Label FontSize="10" HorizontalTextAlignment="Center" InputTransparent="True" Text="One core RichButton, page-owned face" TextColor="#3E7A5B" />
                                    </VerticalStackLayout>
                                </Border>
                            </controls:RichButton>

                            <controls:RichButton
                                Grid.Row="2"
                                Grid.Column="1"
                                AutomationId="DapperDan_Specimen_BottomSheet"
                                AutoResetIsBusyMilliseconds="650"
                                Command="{Binding ExecutePanelDemoCommand}"
                                CommandParameter="Sheet">
                                <Border BackgroundColor="#F4ECFF" InputTransparent="True" Padding="12" Stroke="#BFA4E8" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout InputTransparent="True" Spacing="2" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Bottom sheet" TextColor="#5B3486" />
                                        <Label FontSize="10" HorizontalTextAlignment="Center" InputTransparent="True" Text="Same control, different command" TextColor="#765B94" />
                                    </VerticalStackLayout>
                                </Border>
                            </controls:RichButton>

                            <controls:RichButton
                                Grid.Row="3"
                                AutomationId="DapperDan_Specimen_Dialog"
                                AutoResetIsBusyMilliseconds="650"
                                Command="{Binding ExecutePanelDemoCommand}"
                                CommandParameter="Dialog">
                                <Border BackgroundColor="#FFECE8" InputTransparent="True" Padding="12" Stroke="#E7A496" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout InputTransparent="True" Spacing="2" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Dialog" TextColor="#8E3C2C" />
                                        <Label FontSize="10" HorizontalTextAlignment="Center" InputTransparent="True" Text="Native input into a popup lane" TextColor="#9B6257" />
                                    </VerticalStackLayout>
                                </Border>
                            </controls:RichButton>

                            <controls:RichButton
                                Grid.Row="3"
                                Grid.Column="1"
                                AutomationId="DapperDan_Specimen_AsyncBusy"
                                Command="{Binding AsyncSpecimenCommand}"
                                HeightRequest="72"
                                IsBusy="{Binding IsAsyncSpecimenBusy, Mode=TwoWay}">
                                <Border BackgroundColor="#173E52" InputTransparent="True" Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout InputTransparent="True" Spacing="2" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Async busy" TextColor="White" />
                                        <Label FontSize="10" HorizontalTextAlignment="Center" InputTransparent="True" Text="Command releases the two-way flag" TextColor="#CDE2EC" />
                                    </VerticalStackLayout>
                                </Border>
                            </controls:RichButton>
                        </Grid>

                        <Border BackgroundColor="#FFFFFF" Padding="18" Stroke="#B9CED8" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="12">
                                <Label Style="{StaticResource SectionTitle}" Text="Keiki EF + SQLite pocket" />
                                <Label Style="{StaticResource BodyCopy}" Text="A tiny injected repository proves the skeleton can persist its own data without carrying any product domain." />
                                <Entry AutomationId="DapperDan_Keiki_Name" Placeholder="Name" Style="{StaticResource FieldEntry}" Text="{Binding KeikiName}" />
                                <Entry AutomationId="DapperDan_Keiki_Break" Placeholder="Favorite break" Style="{StaticResource FieldEntry}" Text="{Binding FavoriteBreak}" />
                                <Entry AutomationId="DapperDan_Keiki_Memory" Placeholder="Memory" Style="{StaticResource FieldEntry}" Text="{Binding KeikiMemory}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:RichButton AutomationId="DapperDan_Keiki_Add" Command="{Binding AddKeikiCommand}" HeightRequest="50" IsBusy="{Binding IsKeikiBusy, Mode=TwoWay}">
                                        <Border BackgroundColor="#075985" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Add" TextColor="White" VerticalTextAlignment="Center" />
                                        </Border>
                                    </controls:RichButton>
                                    <controls:RichButton Grid.Column="1" AutomationId="DapperDan_Keiki_Load" Command="{Binding LoadKeikiCommand}" HeightRequest="50" IsBusy="{Binding IsKeikiBusy, Mode=TwoWay}">
                                        <Border BackgroundColor="#DDF3F8" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Load" TextColor="#075985" VerticalTextAlignment="Center" />
                                        </Border>
                                    </controls:RichButton>
                                    <controls:RichButton Grid.Column="2" AutomationId="DapperDan_Keiki_Clear" Command="{Binding ClearKeikiCommand}" HeightRequest="50" IsBusy="{Binding IsKeikiBusy, Mode=TwoWay}">
                                        <Border BackgroundColor="#FFECE8" InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="Center" InputTransparent="True" Text="Clear" TextColor="#8E3C2C" VerticalTextAlignment="Center" />
                                        </Border>
                                    </controls:RichButton>
                                </Grid>
                                <Label FontAttributes="Bold" Text="{Binding KeikiCountText}" TextColor="#173E52" />
                                <CollectionView AutomationId="DapperDan_Keiki_List" HeightRequest="210" ItemsSource="{Binding Keiki}" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="data:Keiki">
                                            <Border BackgroundColor="#F5F9FB" Margin="0,4" Padding="12" Stroke="#D4E2E8" StrokeShape="RoundRectangle 12">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label FontAttributes="Bold" Text="{Binding Name}" TextColor="#173E52" />
                                                        <Label FontSize="12" Text="{Binding FavoriteBreak, StringFormat='Favorite: {0}'}" TextColor="#607D8B" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1" FontSize="11" Text="{Binding Id, StringFormat='#{0}'}" TextColor="#78909C" VerticalTextAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <Grid
                AutomationId="DapperDan_PanelsPanel"
                BackgroundColor="#EAF2F5"
                pb:PanelBoss.PanelIsVisible="False"
                pb:PanelBoss.PanelName="DapperDanPanelsPanel"
                pb:PanelBoss.PanelPriority="0"
                pb:PanelBoss.PanelTransitionIn="FadeInDownward"
                pb:PanelBoss.PanelTransitionOut="FadeOutUpward">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" pb:PanelBoss.PanelClearanceFor="DapperDanHeaderPanel" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="116" pb:PanelBoss.PanelClearanceFor="DapperDanPageActions" />
                </Grid.RowDefinitions>
                <ScrollView Grid.Row="1" AutomationId="DapperDan_PanelsScrollView">
                    <VerticalStackLayout Padding="18" Spacing="16">
                        <Label Style="{StaticResource PageTitle}" Text="Panel lane tiles" />
                        <Label Style="{StaticResource BodyCopy}" Text="Each tile drives one named collection through PanelBoss. Open, close, toggle, priority, smoke, viewport sizing, and owned popup presentation all stay visible here." />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="84" />
                                <RowDefinition Height="84" />
                                <RowDefinition Height="84" />
                                <RowDefinition Height="84" />
                                <RowDefinition Height="84" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:RichButton AutomationId="DapperDan_Lane_NonVisual" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="NonVisual">
                                <Border BackgroundColor="#FFFFFF" InputTransparent="True" Padding="12" Stroke="#B9CED8" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout InputTransparent="True" Spacing="2"><Label FontAttributes="Bold" InputTransparent="True" Text="NonVisualControls" TextColor="#173E52" /><Label FontSize="11" InputTransparent="True" Text="Hidden diagnostics host" TextColor="#607D8B" /></VerticalStackLayout>
                                </Border>
                            </controls:RichButton>
                            <controls:RichButton Grid.Column="1" AutomationId="DapperDan_Lane_TopHeaderPage" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="Tour">
                                <Border BackgroundColor="#0B3C5D" InputTransparent="True" Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout InputTransparent="True" Spacing="2"><Label FontAttributes="Bold" InputTransparent="True" Text="TopHeaderPage" TextColor="White" /><Label FontSize="11" InputTransparent="True" Text="Full viewport tour" TextColor="#D9EDF7" /></VerticalStackLayout>
                                </Border>
                            </controls:RichButton>
                            <controls:RichButton Grid.Row="1" AutomationId="DapperDan_Lane_TopHeader" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="Restore">
                                <Border BackgroundColor="#DDF3F8" InputTransparent="True" Padding="12" Stroke="#8BC4D9" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout InputTransparent="True" Spacing="2"><Label FontAttributes="Bold" InputTransparent="True" Text="TopHeader" TextColor="#075985" /><Label FontSize="11" InputTransparent="True" Text="Default chrome owner" TextColor="#4F7C8E" /></VerticalStackLayout>
                                </Border>
                            </controls:RichButton>
                            <controls:RichButton Grid.Row="1" Grid.Column="1" AutomationId="DapperDan_Lane_Content" AutoResetIsBusyMilliseconds="600" Command="{Binding SelectPageActionCommand}" CommandParameter="{Binding ButtonsAction}">
                                <Border BackgroundColor="#FFFFFF" InputTransparent="True" Padding="12" Stroke="#B9CED8" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout InputTransparent="True" Spacing="2"><Label FontAttributes="Bold" InputTransparent="True" Text="Content" TextColor="#173E52" /><Label FontSize="11" InputTransparent="True" Text="Five mutually exclusive pages" TextColor="#607D8B" /></VerticalStackLayout>
                                </Border>
                            </controls:RichButton>
                            <controls:RichButton Grid.Row="2" AutomationId="DapperDan_Lane_Left" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="Palette">
                                <Border BackgroundColor="#E9F8F0" InputTransparent="True" Padding="12" Stroke="#87C9A5" StrokeShape="RoundRectangle 16"><VerticalStackLayout InputTransparent="True" Spacing="2"><Label FontAttributes="Bold" InputTransparent="True" Text="LeftSelector" TextColor="#17613B" /><Label FontSize="11" InputTransparent="True" Text="Palette drawer" TextColor="#3E7A5B" /></VerticalStackLayout></Border>
                            </controls:RichButton>
                            <controls:RichButton Grid.Row="2" Grid.Column="1" AutomationId="DapperDan_Lane_Right" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="Inspector">
                                <Border BackgroundColor="#F4ECFF" InputTransparent="True" Padding="12" Stroke="#BFA4E8" StrokeShape="RoundRectangle 16"><VerticalStackLayout InputTransparent="True" Spacing="2"><Label FontAttributes="Bold" InputTransparent="True" Text="RightSelector" TextColor="#5B3486" /><Label FontSize="11" InputTransparent="True" Text="Inspector drawer" TextColor="#765B94" /></VerticalStackLayout></Border>
                            </controls:RichButton>
                            <controls:RichButton Grid.Row="3" AutomationId="DapperDan_Lane_Menu" AutoResetIsBusyMilliseconds="600" Command="{Binding ExecutePanelDemoCommand}" CommandParameter="Menu">
