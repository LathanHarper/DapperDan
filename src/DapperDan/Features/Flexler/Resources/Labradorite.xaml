        />
    <SolidColorBrush x:Key="Flexler.PolishedStoneBrush"
        Color="{StaticResource Flexler.PolishedStone}"
        />
    <SolidColorBrush x:Key="Flexler.MineralSeamBrush"
        Color="{StaticResource Flexler.MineralSeam}"
        />
    <SolidColorBrush x:Key="Flexler.IceTextBrush"
        Color="{StaticResource Flexler.IceText}"
        />
    <SolidColorBrush x:Key="Flexler.SilverTextBrush"
        Color="{StaticResource Flexler.SilverText}"
        />
    <SolidColorBrush x:Key="Flexler.AshTextBrush"
        Color="{StaticResource Flexler.AshText}"
        />
