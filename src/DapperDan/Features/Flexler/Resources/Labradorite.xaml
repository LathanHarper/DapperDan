    <!--  Flexler brand grammar: quiet stone, earned flash.  -->
    <Color x:Key="Flexler.LabradoriteVoid">#070A0E</Color>
    <Color x:Key="Flexler.RawMatrix">#0B1117</Color>
    <Color x:Key="Flexler.Cleavage">#121B22</Color>
    <Color x:Key="Flexler.PolishedStone">#18242C</Color>
    <Color x:Key="Flexler.MineralSeam">#2C3D46</Color>

    <Color x:Key="Flexler.Frost">#E7EEEA</Color>
