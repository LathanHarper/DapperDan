<?xml version="1.0" encoding="utf-8" ?>
<ContentPage AutomationId="Flexler_MainPage" Title="Flexler" Background="{StaticResource Flexler.VoidBrush}"
    x:Class="Flexler.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:Flexler.Behaviors"
    xmlns:controls="clr-namespace:Flexler.Controls"
    xmlns:models="clr-namespace:Flexler.Models"
    xmlns:panelViews="clr-namespace:Flexler.PanelBossKit.Views"
    xmlns:pb="clr-namespace:Flexler.PanelBossKit"
    xmlns:primo="clr-namespace:PrimoMaterial"
    xmlns:vm="clr-namespace:Flexler.ViewModels"
    x:DataType="vm:MainPageViewModel"
    Padding="0"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="Container"
    >
    <ContentPage.Resources>
        <!--
            Host isolation only: empty styles shadow Dapper's application defaults.
            All FleXler layout, materials, state and values remain on their owners.
        -->
        <Style
            ApplyToDerivedTypes="True"
            TargetType="Page"
            />
        <Style
            TargetType="Border"
            />
        <Style
            TargetType="BoxView"
            />
        <Style
            TargetType="Entry"
            />
        <Style
            TargetType="Label"
            />
        <Style
            TargetType="Picker"
            />
        <Style
            TargetType="ScrollView"
            />
        <Style
            TargetType="Shadow"
            />
        <Style
            TargetType="Switch"
            />
    </ContentPage.Resources>
    <panelViews:PanelBossBody_DefaultView x:Name="PanelBossRoot" AutomationId="Flexler_PanelBossRoot" PanelBossInstance="{Binding ActivePanelBoss}"
        SafeAreaEdges="None"
        >
        <panelViews:PanelBossBody_DefaultView.ContentPanels>
            <Grid AutomationId="Flexler_WorkspacePanel"
                pb:PanelBoss.PanelName="FlexlerWorkspacePanel"
                pb:PanelBoss.PanelIsVisible="True"
                pb:PanelBoss.PanelPriority="10"
                pb:PanelBoss.PanelTransitionIn="None"
                pb:PanelBoss.PanelTransitionOut="None"
                IsClippedToBounds="True"
                SafeAreaEdges="None"
                >
                <AbsoluteLayout
                    IsClippedToBounds="True"
                    SafeAreaEdges="None"
                    InputTransparent="True"
                    >
                    <controls:MineralAtmosphereView
                        AbsoluteLayout.LayoutBounds="0,0,1,1"
                        AbsoluteLayout.LayoutFlags="All"
                        />
                </AbsoluteLayout>
                <Grid x:Name="WorkspaceInset"
                    RowDefinitions="Auto,*,Auto"
                    SafeAreaEdges="None"
                    >
                    <Grid
                        IsVisible="True"
                        Grid.Row="0"
                        SafeAreaEdges="None"
                        InputTransparent="True"
                        >
                        <Grid.Triggers>
                            <DataTrigger
                                Binding="{Binding UseSidePanelLayout,
                                                  Source={x:Reference PanelBossRoot},
                                                  x:DataType=panelViews:PanelBossBody_DefaultView}"
                                TargetType="Grid"
                                Value="True"
                                >
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <BoxView x:Name="HeaderPanelClearance" AutomationId="Flexler_HeaderPanelClearance" BackgroundColor="Transparent"
                            x:DataType="Grid"
                            IsVisible="{Binding IsVisible,
                                                Source={x:Reference HeaderPanel},
                                                Mode=OneWay}"
                            HeightRequest="{Binding Height,
                                                    Source={x:Reference HeaderPanel},
                                                    Mode=OneWay}"
                            Color="Transparent"
                            InputTransparent="True"
                            />
                        <BoxView x:Name="ContainerControlsPanelClearance" AutomationId="Flexler_ContainerControlsPanelClearance" BackgroundColor="Transparent"
                            x:DataType="Grid"
                            IsVisible="{Binding IsVisible,
                                                Source={x:Reference ContainerControlsPanel},
                                                Mode=OneWay}"
                            HeightRequest="{Binding Height,
                                                    Source={x:Reference ContainerControlsPanel},
                                                    Mode=OneWay}"
                            Color="Transparent"
                            InputTransparent="True"
                            />
                    </Grid>
                    <Grid
                        IsVisible="True"
                        Grid.Row="2"
                        SafeAreaEdges="None"
                        InputTransparent="True"
                        >
                        <Grid.Triggers>
                            <DataTrigger
                                Binding="{Binding UseSidePanelLayout,
                                                  Source={x:Reference PanelBossRoot},
                                                  x:DataType=panelViews:PanelBossBody_DefaultView}"
                                TargetType="Grid"
                                Value="True"
                                >
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <BoxView x:Name="BottomActionsPanelClearance" AutomationId="Flexler_BottomActionsPanelClearance" BackgroundColor="Transparent"
                            x:DataType="Grid"
                            IsVisible="{Binding IsVisible,
                                                Source={x:Reference BottomActionsPanel},
                                                Mode=OneWay}"
                            HeightRequest="{Binding Height,
                                                    Source={x:Reference BottomActionsPanel},
                                                    Mode=OneWay}"
                            Color="Transparent"
                            InputTransparent="True"
                            />
                        <BoxView x:Name="InspectorPanelClearance" AutomationId="Flexler_InspectorPanelClearance" BackgroundColor="Transparent"
                            x:DataType="Grid"
                            IsVisible="{Binding IsVisible,
                                                Source={x:Reference InspectorPanel},
                                                Mode=OneWay}"
                            HeightRequest="{Binding Height,
                                                    Source={x:Reference InspectorPanel},
                                                    Mode=OneWay}"
                            Color="Transparent"
                            InputTransparent="True"
                            />
                        <BoxView x:Name="RecipePanelClearance" AutomationId="Flexler_RecipePanelClearance" BackgroundColor="Transparent"
                            x:DataType="Grid"
                            IsVisible="{Binding IsVisible,
                                                Source={x:Reference RecipePanel},
                                                Mode=OneWay}"
                            HeightRequest="{Binding Height,
                                                    Source={x:Reference RecipePanel},
                                                    Mode=OneWay}"
                            Color="Transparent"
                            InputTransparent="True"
                            />
                    </Grid>
                    <Grid x:Name="WorkspaceHorizontalInset"
                        Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        SafeAreaEdges="None"
                        >
                        <Grid
                            Grid.Column="1"
                            Margin="12"
                            SafeAreaEdges="None"
                            >
                            <Border Background="{StaticResource Flexler.FlexStageChromeBrush}"
                                Stroke="{StaticResource Flexler.JewelerRailBrush}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="{StaticResource Flexler.SurfaceStrokeThickness}"
                                InputTransparent="True"
                                >
                                <Border.Shadow>
                                    <Shadow
                                        Brush="{StaticResource Flexler.WorkplaneShadowBrush}"
                                        Opacity="0.82"
                                        Radius="28"
                                        Offset="0,12"
                                        />
                                </Border.Shadow>
                            </Border>
                            <Grid x:Name="WorkspaceChromeContent"
                                Padding="12"
                                RowDefinitions="Auto,*,Auto"
                                RowSpacing="10"
                                SafeAreaEdges="None"
                                >
                                <Grid
                                    Padding="3,0"
                                    ColumnDefinitions="*,Auto,Auto"
                                    ColumnSpacing="10"
                                    SafeAreaEdges="None"
                                    >
                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="8"
                                        SafeAreaEdges="None"
                                        >
                                        <BoxView Background="{StaticResource Flexler.SpectralFlashBrush}"
                                            VerticalOptions="Center"
                                            CornerRadius="3"
                                            HeightRequest="6"
                                            WidthRequest="6"
                                            InputTransparent="True"
                                            />
                                        <Label
                                            Grid.Column="1"
                                            VerticalTextAlignment="Center"
                                            CharacterSpacing="{StaticResource Flexler.SectionTitleTracking}"
                                            FontFamily="{StaticResource Flexler.EmphasisFontFamily}"
                                            FontSize="{StaticResource Flexler.StatusFontSize}"
                                            Text="LIVE FLEX SURFACE"
                                            TextColor="{StaticResource Flexler.SilverText}"
                                            />
                                    </Grid>
                                    <Grid
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        SafeAreaEdges="None"
                                        >
                                        <Border Background="{StaticResource Flexler.CounterPillBrush}"
                                            Stroke="{StaticResource Flexler.LivePillStrokeBrush}"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="{StaticResource Flexler.SurfaceStrokeThickness}"
                                            InputTransparent="True"
                                            />
                                        <Label AutomationId="Flexler_ItemCount_Label"
                                            Margin="10,4"
                                            FontFamily="{StaticResource Flexler.CodeFontFamily}"
                                            FontSize="{StaticResource Flexler.StatusFontSize}"
                                            Text="{Binding Items.Count,
                                                           StringFormat='{0} ITEMS'}"
                                            TextColor="{StaticResource Flexler.FlashAqua}"
                                            />
                                    </Grid>
                                    <controls:RichButton x:Name="AddButton" AutomationId="Flexler_AddItem_Button"
                                        Grid.Column="2"
                                        AutoResetIsBusyMilliseconds="120"
                                        Command="{Binding AddItemCommand}"
                                        MinimumHeightRequest="{StaticResource Flexler.ControlMinimumHeight}"
                                        SafeAreaEdges="None"
                                        SemanticProperties.Description="Add an item to the recipe"
                                        WidthRequest="44"
                                        >
                                        <Grid
                                            SafeAreaEdges="None"
                                            InputTransparent="True"
                                            >
                                            <Border Background="{StaticResource Flexler.FlexFacetBrush}"
                                                Stroke="{StaticResource Flexler.FlashAqua}"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="{StaticResource Flexler.SurfaceStrokeThickness}"
                                                InputTransparent="True"
                                                />
                                            <Label
                                                Margin="0"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                CharacterSpacing="{StaticResource Flexler.CommandTracking}"
                                                FontFamily="{StaticResource Flexler.EmphasisFontFamily}"
                                                FontSize="{StaticResource Flexler.AddGlyphFontSize}"
                                                Text="+"
                                                TextColor="{StaticResource Flexler.MineralInk}"
                                                InputTransparent="True"
                                                />
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup Name="TouchStates"
                                                    >
                                                    <VisualState Name="WaitingForTouch"
                                                        />
                                                    <VisualState Name="IsProcessing"
                                                        >
                                                        <VisualState.Setters>
                                                            <Setter Property="Opacity" Value="{StaticResource Flexler.BusyActionOpacity}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Grid>
                                    </controls:RichButton>
                                </Grid>
                                <Grid AutomationId="Flexler_Canvas"
                                    Grid.Row="1"
                                    IsClippedToBounds="True"
                                    SafeAreaEdges="None"
                                    >
                                    <AbsoluteLayout
                                        IsClippedToBounds="True"
                                        SafeAreaEdges="None"
                                        InputTransparent="True"
                                        >
                                        <primo:CrossFade_RadoDots AutomationId="Flexler_PrimoMaterial_Field"
                                            AbsoluteLayout.LayoutBounds="0,0,1,1"
                                            AbsoluteLayout.LayoutFlags="All"
                                            InputBrushOne="{StaticResource Flexler.PrimoRadoDotsFieldBaseBrush}"
                                            InputBrushTwo="{StaticResource Flexler.PrimoRadoDotsFieldFireBrush}"
                                            InputTransparent="True"
                                            >
                                            <primo:CrossFade_RadoDots.Clip>
                                                <RoundRectangleGeometry
                                                    CornerRadius="8"
                                                    />
                                            </primo:CrossFade_RadoDots.Clip>
                                        </primo:CrossFade_RadoDots>
                                        <Image
                                            Margin="1"
                                            Source="labradorite_polished.jpg"
                                            AbsoluteLayout.LayoutBounds="0,0,1,1"
                                            AbsoluteLayout.LayoutFlags="All"
                                            Aspect="AspectFill"
                                            Opacity="0.38"
                                            Scale="1.06"
                                            TranslationX="-18"
                                            InputTransparent="True"
                                            />
                                        <Border Background="{StaticResource Flexler.FlexDisplayStoneVeilBrush}"
                                            AbsoluteLayout.LayoutBounds="0,0,1,1"
                                            AbsoluteLayout.LayoutFlags="All"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            InputTransparent="True"
                                            />
                                        <Border Background="{StaticResource Flexler.FlexDisplayGlowBrush}"
                                            AbsoluteLayout.LayoutBounds="0,0,1,1"
                                            AbsoluteLayout.LayoutFlags="All"
                                            Opacity=".35"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            InputTransparent="True"
                                            />
                                        <Border Background="{StaticResource Flexler.FlexDisplaySpectrumBrush}"
                                            AbsoluteLayout.LayoutBounds="0,0,1,1"
                                            AbsoluteLayout.LayoutFlags="All"
                                            Opacity=".5"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            InputTransparent="True"
                                            />
                                    </AbsoluteLayout>
                                    <FlexLayout x:Name="LiveFlex" AutomationId="Flexler_Live_FlexLayout"
                                        Padding="18"
                                        AlignContent="{Binding AlignContent}"
                                        AlignItems="{Binding AlignItems}"
                                        BindableLayout.ItemsSource="{Binding Items}"
                                        Direction="{Binding Direction}"
                                        JustifyContent="{Binding JustifyContent}"
                                        SafeAreaEdges="None"
                                        Wrap="{Binding Wrap}"
                                        >
                                        <FlexLayout.Behaviors>
                                            <behaviors:FlexLayoutRefreshBehavior />
                                        </FlexLayout.Behaviors>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="vm:FlexItemViewModel"
                                                >
                                                <controls:RichButton AutomationId="{Binding AutomationId}"
                                                    AutoResetIsBusyMilliseconds="150"
                                                    Command="{Binding EditItemCommand,
                                                                      Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}},
                                                                      x:DataType=vm:MainPageViewModel}"
                                                    CommandParameter="{Binding .}"
                                                    FlexLayout.AlignSelf="{Binding AlignSelf}"
                                                    FlexLayout.Basis="{Binding Basis}"
                                                    FlexLayout.Grow="{Binding Grow}"
                                                    FlexLayout.Order="{Binding Order}"
                                                    FlexLayout.Shrink="{Binding Shrink}"
                                                    MinimumHeightRequest="{StaticResource Flexler.PrimaryActionMinimumHeight}"
                                                    SafeAreaEdges="None"
                                                    SemanticProperties.Description="{Binding Text,
                                                                                             StringFormat='Shape item: {0}'}"
                                                    SemanticProperties.Hint="Open the item shaper"
                                                    >
                                                    <Grid
                                                        SafeAreaEdges="None"
                                                        InputTransparent="True"
                                                        >
                                                        <Border Background="{StaticResource Flexler.FlexItemSurfaceBrush}"
                                                            Stroke="{StaticResource Flexler.FlexItemStrokeBrush}"
                                                            StrokeShape="RoundRectangle 5"
                                                            StrokeThickness="{StaticResource Flexler.SurfaceStrokeThickness}"
                                                            InputTransparent="True"
                                                            >
                                                            <Border.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding IsSelected}"
                                                                    TargetType="Border"
                                                                    Value="True"
                                                                    >
                                                                    <Setter Property="Background" Value="{StaticResource Flexler.FlexItemSelectedBrush}" />
                                                                    <Setter Property="Stroke" Value="{StaticResource Flexler.FlexItemSelectedStrokeBrush}" />
                                                                    <Setter Property="StrokeThickness" Value="{StaticResource Flexler.SelectedStrokeThickness}" />
                                                                    <Setter Property="Shadow">
                                                                        <Setter.Value>
                                                                            <Shadow
                                                                                Brush="{StaticResource Flexler.FlexItemSelectedGlowBrush}"
                                                                                Opacity="0.68"
                                                                                Radius="14"
                                                                                Offset="0,4"
                                                                                />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                        </Border>
                                                        <Label
                                                            Margin="14,8"
                                                            VerticalTextAlignment="Center"
                                                            FontFamily="{StaticResource Flexler.EmphasisFontFamily}"
                                                            FontSize="{StaticResource Flexler.FacetFontSize}"
                                                            MinimumHeightRequest="{StaticResource Flexler.FacetMinimumHeight}"
                                                            Text="{Binding Text}"
                                                            TextColor="{StaticResource Flexler.IceText}"
                                                            InputTransparent="True"
                                                            />
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup Name="TouchStates"
                                                                >
                                                                <VisualState Name="WaitingForTouch"
                                                                    />
                                                                <VisualState Name="IsProcessing"
                                                                    >
                                                                    <VisualState.Setters>
                                                                        <Setter Property="Opacity" Value="{StaticResource Flexler.BusyActionOpacity}" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </Grid>
                                                </controls:RichButton>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                    <Label AutomationId="Flexler_EmptyRecipe_Label"
                                        IsVisible="False"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        FontFamily="{StaticResource Flexler.BodyFontFamily}"
                                        FontSize="{StaticResource Flexler.EmptyStateFontSize}"
                                        Text="Your next layout starts here. Tap + to add an item."
                                        TextColor="{StaticResource Flexler.IceText}"
                                        InputTransparent="True"
                                        >
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Items.Count}"
                                                TargetType="Label"
                                                Value="0"
                                                >
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border
                                        Stroke="{StaticResource Flexler.JewelerRailBrush}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="{StaticResource Flexler.SurfaceStrokeThickness}"
                                        ZIndex="10"
                                        InputTransparent="True"
                                        />
                                </Grid>
                                <Grid
                                    Grid.Row="2"
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="3"
                                    SafeAreaEdges="None"
                                    >
                                    <Label AutomationId="Flexler_LayoutSummary_Label"
                                        FontFamily="{StaticResource Flexler.CodeFontFamily}"
                                        FontSize="{StaticResource Flexler.StatusFontSize}"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding LayoutSummary}"
                                        TextColor="{StaticResource Flexler.SilverText}"
                                        />
                                    <Label
                                        Grid.Row="1"
                                        FontFamily="{StaticResource Flexler.BodyFontFamily}"
                                        FontSize="{StaticResource Flexler.StatusFontSize}"
                                        Text="Click an item to shape it · Tab + Enter works too"
                                        TextColor="{StaticResource Flexler.AshText}"
                                        />
                                </Grid>
                            </Grid>
                        </Grid>
                        <Grid
                            IsVisible="False"
                            Grid.Column="0"
                            SafeAreaEdges="None"
                            InputTransparent="True"
                            >
                            <Grid.Triggers>
                                <DataTrigger
                                    Binding="{Binding UseSidePanelLayout,
                                                      Source={x:Reference PanelBossRoot},
                                                      x:DataType=panelViews:PanelBossBody_DefaultView}"
                                    TargetType="Grid"
                                    Value="True"
                                    >
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <BoxView x:Name="LandscapeHeaderPanelClearance" AutomationId="Flexler_LandscapeHeaderPanelClearance" BackgroundColor="Transparent"
                                x:DataType="Grid"
                                IsVisible="{Binding IsVisible,
                                                    Source={x:Reference LandscapeHeaderPanel},
                                                    Mode=OneWay}"
                                WidthRequest="{Binding Width,
                                                       Source={x:Reference LandscapeHeaderPanel},
                                                       Mode=OneWay}"
                                Color="Transparent"
                                InputTransparent="True"
                                />
                            <BoxView x:Name="LandscapeContainerControlsPanelClearance" AutomationId="Flexler_LandscapeContainerControlsPanelClearance" BackgroundColor="Transparent"
                                x:DataType="Grid"
                                IsVisible="{Binding IsVisible,
                                                    Source={x:Reference LandscapeContainerControlsPanel},
                                                    Mode=OneWay}"
                                WidthRequest="{Binding Width,
                                                       Source={x:Reference LandscapeContainerControlsPanel},
                                                       Mode=OneWay}"
                                Color="Transparent"
                                InputTransparent="True"
                                />
                        </Grid>
                        <Grid
                            IsVisible="False"
                            Grid.Column="2"
                            SafeAreaEdges="None"
                            InputTransparent="True"
                            >
                            <Grid.Triggers>
                                <DataTrigger
                                    Binding="{Binding UseSidePanelLayout,
                                                      Source={x:Reference PanelBossRoot},
                                                      x:DataType=panelViews:PanelBossBody_DefaultView}"
                                    TargetType="Grid"
                                    Value="True"
                                    >
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <BoxView x:Name="LandscapeBottomActionsPanelClearance" AutomationId="Flexler_LandscapeBottomActionsPanelClearance" BackgroundColor="Transparent"
                                x:DataType="Grid"
                                IsVisible="{Binding IsVisible,
                                                    Source={x:Reference LandscapeBottomActionsPanel},
                                                    Mode=OneWay}"
                                WidthRequest="{Binding Width,
                                                       Source={x:Reference LandscapeBottomActionsPanel},
                                                       Mode=OneWay}"
                                Color="Transparent"
                                InputTransparent="True"
                                />
                            <BoxView x:Name="LandscapeInspectorPanelClearance" AutomationId="Flexler_LandscapeInspectorPanelClearance" BackgroundColor="Transparent"
                                x:DataType="Grid"
                                IsVisible="{Binding IsVisible,
                                                    Source={x:Reference LandscapeInspectorPanel},
                                                    Mode=OneWay}"
                                WidthRequest="{Binding Width,
                                                       Source={x:Reference LandscapeInspectorPanel},
                                                       Mode=OneWay}"
                                Color="Transparent"
                                InputTransparent="True"
                                />
                            <BoxView x:Name="LandscapeRecipePanelClearance" AutomationId="Flexler_LandscapeRecipePanelClearance" BackgroundColor="Transparent"
                                x:DataType="Grid"
                                IsVisible="{Binding IsVisible,
                                                    Source={x:Reference LandscapeRecipePanel},
                                                    Mode=OneWay}"
                                WidthRequest="{Binding Width,
                                                       Source={x:Reference LandscapeRecipePanel},
                                                       Mode=OneWay}"
                                Color="Transparent"
                                InputTransparent="True"
                                />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </panelViews:PanelBossBody_DefaultView.ContentPanels>
        <panelViews:PanelBossBody_DefaultView.TopHeaderPanels>
            <Grid x:Name="HeaderPanel" AutomationId="Flexler_HeaderPanel" Background="{StaticResource Flexler.ChromeShellBrush}"
                pb:PanelBoss.PanelName="FlexlerHeaderPanel"
                pb:PanelBoss.PanelIsVisible="True"
                pb:PanelBoss.PanelPriority="10"
                pb:PanelBoss.PanelTransitionIn="None"
                pb:PanelBoss.PanelTransitionOut="None"
                SafeAreaEdges="None"
                >
                <AbsoluteLayout
                    IsClippedToBounds="True"
                    SafeAreaEdges="None"
                    InputTransparent="True"
                    >
                    <Image x:Name="HeaderMaterialLayer"
                        Source="labradorite_polished.jpg"
                        AbsoluteLayout.LayoutBounds="0,0,1,1"
                        AbsoluteLayout.LayoutFlags="All"
                        Aspect="AspectFill"
                        Opacity="0.20"
                        Scale="1.08"
                        TranslationX="-10"
                        InputTransparent="True"
                        />
                    <BoxView Background="{StaticResource Flexler.PolishedChromeVeilBrush}"
                        AbsoluteLayout.LayoutBounds="0,0,1,1"
                        AbsoluteLayout.LayoutFlags="All"
                        InputTransparent="True"
                        />
                </AbsoluteLayout>
                <Grid
                    Padding="14,12"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="10"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="8"
                    SafeAreaEdges="None"
                    >
                    <Image AutomationId="Flexler_BrandMark"
                        Source="flexler_spring_dark.png"
                        Aspect="AspectFit"
                        HeightRequest="{StaticResource Flexler.BrandSpringHeight}"
                        WidthRequest="{StaticResource Flexler.BrandSpringWidth}"
                        InputTransparent="True"
                        />
                    <Grid
                        Grid.Column="1"
                        VerticalOptions="Center"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="0"
                        SafeAreaEdges="None"
                        >
                        <Image AutomationId="Flexler_BrandWordmark"
                            HorizontalOptions="Start"
                            Source="flexler_wordmark_dark.png"
                            Aspect="AspectFit"
                            HeightRequest="{StaticResource Flexler.BrandWordmarkHeight}"
                            SemanticProperties.Description="Flexler"
                            WidthRequest="{StaticResource Flexler.BrandWordmarkWidth}"
                            InputTransparent="True"
                            />
                        <Label
                            Grid.Row="1"
                            FontFamily="{StaticResource Flexler.BodyFontFamily}"
                            FontSize="{StaticResource Flexler.StatusFontSize}"
                            Text="Shape the layout. Keep the recipe."
                            TextColor="{StaticResource Flexler.SilverText}"
                            />
                    </Grid>
                    <Grid x:Name="HeaderActions"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="8"
                        SafeAreaEdges="None"
                        >
                        <controls:RichButton AutomationId="Flexler_Showcase_Back_Button"
                            Grid.Column="2"
                            Command="{Binding BackToDapperCommand}"
                            IsBusy="{Binding IsReturningToDapper,
                                             Mode=TwoWay}"
                            MinimumHeightRequest="{StaticResource Flexler.ControlMinimumHeight}"
                            MinimumWidthRequest="{StaticResource Flexler.ControlMinimumHeight}"
                            SafeAreaEdges="None"
                            SemanticProperties.Description="Back to Dapper Dan"
                            >
                            <Grid
                                SafeAreaEdges="None"
                                InputTransparent="True"
                                >
                                <Border Background="{StaticResource Flexler.ChromeControlBrush}"
                                    Stroke="{StaticResource Flexler.MineralSeam}"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="{StaticResource Flexler.SurfaceStrokeThickness}"
                                    InputTransparent="True"
                                    />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontFamily="{StaticResource Flexler.EmphasisFontFamily}"
                                    FontSize="{StaticResource Flexler.ShowcaseBackGlyphFontSize}"
                                    Text="&#x2039;"
                                    TextColor="{StaticResource Flexler.IceText}"
                                    InputTransparent="True"
                                    />
                            </Grid>
                        </controls:RichButton>
                        <controls:RichButton AutomationId="Flexler_OpenContainerControls_Button"
                            Command="{Binding ToggleContainerControlsCommand}"
                            IsBusy="{Binding IsContainerBusy,
                                             Mode=TwoWay}"
                            MinimumHeightRequest="{StaticResource Flexler.ControlMinimumHeight}"
                            SafeAreaEdges="None"
                            SemanticProperties.Description="CONTAINER"
                            >
                            <Grid
                                SafeAreaEdges="None"
                                InputTransparent="True"
                                >
                                <Border Background="{StaticResource Flexler.ChromeControlBrush}"
