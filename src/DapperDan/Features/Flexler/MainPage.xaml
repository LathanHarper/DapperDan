                                            InputTransparent="True"
                                            />
                                    </Grid>
                                </controls:RichButton>
                            </Grid>
                            <Picker AutomationId="Flexler_FavoritesPicker_Landscape" Title="Choose a saved layout" Background="{StaticResource Flexler.DrawerFieldBrush}"
                                Grid.Row="1"
                                FontFamily="{StaticResource Flexler.CodeFontFamily}"
                                FontSize="{StaticResource Flexler.FieldFontSize}"
                                ItemDisplayBinding="{Binding Name,
                                                             x:DataType=models:FavoriteRecipe}"
                                ItemsSource="{Binding Favorites}"
                                MinimumHeightRequest="{StaticResource Flexler.ControlMinimumHeight}"
                                SelectedItem="{Binding SelectedFavorite,
                                                       Mode=TwoWay}"
                                SemanticProperties.Description="Saved favorites"
                                TextColor="{StaticResource Flexler.IceText}"
                                TitleColor="{StaticResource Flexler.SilverText}"
                                />
                            <Label
                                Grid.Row="2"
                                FontFamily="{StaticResource Flexler.CodeFontFamily}"
                                FontSize="{StaticResource Flexler.StatusFontSize}"
                                Text="{Binding FavoriteSummary}"
                                TextColor="{StaticResource Flexler.SilverText}"
                                />
                            <Grid
                                Grid.Row="3"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8"
                                SafeAreaEdges="None"
                                >
                                <controls:RichButton AutomationId="Flexler_LoadFavorite_Button_Landscape"
                                    Grid.Column="0"
                                    Command="{Binding LoadFavoriteCommand}"
                                    IsBusy="{Binding IsFavoriteBusy,
                                                     Mode=TwoWay}"
                                    MinimumHeightRequest="{StaticResource Flexler.ControlMinimumHeight}"
                                    SafeAreaEdges="None"
                                    SemanticProperties.Description="LOAD"
                                    >
                                    <Grid
                                        SafeAreaEdges="None"
                                        InputTransparent="True"
                                        >
                                        <Border Background="{StaticResource Flexler.ChromeControlBrush}"
                                            Stroke="{StaticResource Flexler.MineralSeam}"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="{StaticResource Flexler.SurfaceStrokeThickness}"
                                            InputTransparent="True"
                                            />
                                        <Label
                                            Margin="10,8"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            CharacterSpacing="{StaticResource Flexler.CommandTracking}"
                                            FontFamily="{StaticResource Flexler.EmphasisFontFamily}"
                                            FontSize="{StaticResource Flexler.CommandFontSize}"
                                            Text="LOAD"
                                            TextColor="{StaticResource Flexler.IceText}"
                                            InputTransparent="True"
                                            />
                                    </Grid>
                                </controls:RichButton>
                                <controls:RichButton AutomationId="Flexler_DeleteFavorite_Button_Landscape"
                                    Grid.Column="1"
                                    Command="{Binding DeleteFavoriteCommand}"
                                    IsBusy="{Binding IsFavoriteBusy,
                                                     Mode=TwoWay}"
                                    MinimumHeightRequest="{StaticResource Flexler.ControlMinimumHeight}"
                                    SafeAreaEdges="None"
                                    SemanticProperties.Description="{Binding DeleteFavoriteLabel}"
                                    >
                                    <Grid
                                        SafeAreaEdges="None"
                                        InputTransparent="True"
                                        >
                                        <Border Background="{StaticResource Flexler.ChromeControlBrush}"
                                            Stroke="{StaticResource Flexler.MineralSeam}"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="{StaticResource Flexler.SurfaceStrokeThickness}"
                                            InputTransparent="True"
                                            />
                                        <Label
                                            Margin="10,8"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            CharacterSpacing="{StaticResource Flexler.CommandTracking}"
                                            FontFamily="{StaticResource Flexler.EmphasisFontFamily}"
                                            FontSize="{StaticResource Flexler.CommandFontSize}"
                                            Text="{Binding DeleteFavoriteLabel}"
                                            TextColor="{StaticResource Flexler.IceText}"
                                            InputTransparent="True"
                                            />
                                    </Grid>
                                </controls:RichButton>
                            </Grid>
                        </Grid>
                    </ScrollView>
                    <Label AutomationId="Flexler_FavoritesStatus_Landscape"
                        IsVisible="{Binding IsFavoritesView}"
                        Grid.Row="2"
                        FontFamily="{StaticResource Flexler.BodyFontFamily}"
                        FontSize="{StaticResource Flexler.StatusFontSize}"
                        Text="{Binding FavoritesStatus}"
                        TextColor="{StaticResource Flexler.SilverText}"
                        />
                </Grid>
            </Grid>
        </panelViews:PanelBossBody_DefaultView.RightSelectorPanels>
    </panelViews:PanelBossBody_DefaultView>
</ContentPage>
