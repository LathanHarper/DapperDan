<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\DapperDan\Diagnostics\CrashJournal.cs" Link="Production\CrashJournal.cs" />
    <Compile Include="..\..\src\DapperDan\Diagnostics\DurableCrashJournal.cs" Link="Production\DurableCrashJournal.cs" />
    <Compile Include="..\..\src\DapperDan\Data\Entities\Keiki.cs" Link="Production\Keiki.cs" />
    <Compile Include="..\..\src\DapperDan\Data\Entities\KeikiMemory.cs" Link="Production\KeikiMemory.cs" />
    <Compile Include="..\..\src\DapperDan\Data\DapperDanDbContext.cs" Link="Production\DapperDanDbContext.cs" />
    <Compile Include="..\..\src\DapperDan\Data\CompiledModels\*.cs" Link="Production\CompiledModels\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\DapperDan\Data\DapperDanDatabaseMetadata.cs" Link="Production\DapperDanDatabaseMetadata.cs" />
    <Compile Include="..\..\src\DapperDan\Data\DatabaseInitializer.cs" Link="Production\DatabaseInitializer.cs" />
    <Compile Include="..\..\src\DapperDan\Data\IDatabasePathProvider.cs" Link="Production\IDatabasePathProvider.cs" />
    <Compile Include="..\..\src\DapperDan\Data\IKeikiRepository.cs" Link="Production\IKeikiRepository.cs" />
    <Compile Include="..\..\src\DapperDan\Data\IPackagedDatabaseSource.cs" Link="Production\IPackagedDatabaseSource.cs" />
    <Compile Include="..\..\src\DapperDan\Data\KeikiRepository.cs" Link="Production\KeikiRepository.cs" />
    <Compile Include="..\..\src\DapperDan\Data\PackagedDatabaseInstaller.cs" Link="Production\PackagedDatabaseInstaller.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\DapperDan\Resources\Raw\dapper-dan-seed-v1.db3"
          Link="dapper-dan-seed-v1.db3"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
